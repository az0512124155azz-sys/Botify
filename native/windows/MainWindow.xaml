<Window x:Class="BotHub.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BotHub" Height="800" Width="1080" MinWidth="760" MinHeight="600" Background="#F5F8FA">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="BotHub" FontSize="30" FontWeight="Bold" Foreground="#20343E"/><TextBlock Name="Status" Margin="0,8" Text="Sign in with your Telegram account" TextWrapping="Wrap"/></StackPanel>
<StackPanel Grid.Row="1" Name="LoginPanel" Margin="0,0,0,12">
<WrapPanel Name="AppCredentials"><TextBox Name="ApiId" Width="110" Padding="8" ToolTip="Telegram API ID"/><PasswordBox Name="ApiHash" Width="280" Padding="8" Margin="8,0" ToolTip="Telegram API hash"/><Button Name="Connect" Content="Connect Telegram" Click="ConnectClicked" Padding="12,8"/></WrapPanel>
<WrapPanel Name="AuthPanel" Visibility="Collapsed" Margin="0,8,0,0"><TextBlock Name="AuthPrompt" VerticalAlignment="Center" Margin="0,0,8,0"/><PasswordBox Name="Credential" Width="240" Padding="8"/><Button Content="Continue" Click="SubmitClicked" Padding="12,8" Margin="8,0"/><Button Content="Resend code" Click="ResendClicked" Padding="12,8"/></WrapPanel>
</StackPanel>
<Grid Grid.Row="2" Name="ClientPanel" IsEnabled="False"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<DockPanel Margin="0,0,16,0"><StackPanel DockPanel.Dock="Top"><ComboBox Name="FeedFilter" SelectionChanged="FilterChanged" SelectedIndex="0" Margin="0,0,0,8"><ComboBoxItem Content="All bots"/><ComboBoxItem Content="Interactive"/><ComboBoxItem Content="Alerts"/></ComboBox><TextBox Name="BotLink" Padding="8" ToolTip="@username or https://t.me/bot?start=…"/><Button Content="Open bot" Click="OpenBotClicked" Padding="8" Margin="0,6"/><Button Content="Refresh bots" Click="RefreshClicked" Padding="8" Margin="0,0,0,6"/></StackPanel><Button DockPanel.Dock="Bottom" Content="Log out" Click="LogoutClicked" Padding="8" Margin="0,10,0,0"/><ListBox Name="Chats" SelectionChanged="ChatSelected" DisplayMemberPath="Label"/></DockPanel>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Name="ChatTitle" Text="Only bots. No groups, no noise." FontWeight="Bold" FontSize="20" TextWrapping="Wrap"/>
<WrapPanel Grid.Row="1" Margin="0,10"><Button Name="Category" Content="Interactive" Click="CategoryClicked" Padding="8"/><Button Name="Noise" Content="Notifications: quiet" Click="NoiseClicked" Padding="8" Margin="8,0"/><Button Content="Older messages" Click="OlderClicked" Padding="8"/></WrapPanel>
<ComboBox Grid.Row="2" Name="Commands" DisplayMemberPath="Label" SelectionChanged="CommandSelected" Margin="0,0,0,8"/>
<ScrollViewer Name="HistoryScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto"><StackPanel Name="Messages"/></ScrollViewer>
<DockPanel Grid.Row="4" Name="ComposePanel" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Name="Send" Content="Send" Padding="12,8" Click="SendClicked"/><TextBox Name="Composer" TextChanged="DraftChanged" Padding="10" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"/></DockPanel>
</Grid></Grid></Grid></Window>
