<Window x:Class="BotHub.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BotHub" Height="720" Width="950" MinWidth="620" Background="#F5F8FA">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="BotHub" FontSize="32" FontWeight="Bold" Foreground="#20343E"/>
<StackPanel Grid.Row="1" Margin="0,16,0,12">
<TextBlock Name="Status" Text="Connect Telegram with your Telegram developer API ID and hash." TextWrapping="Wrap"/>
<WrapPanel Margin="0,9,0,0">
<TextBox Name="ApiId" Width="100" Margin="0,0,8,8" Padding="8" ToolTip="Telegram API ID"/>
<TextBox Name="ApiHash" Width="290" Margin="0,0,8,8" Padding="8" ToolTip="Telegram API hash"/>
<Button Name="Connect" Content="Connect TDLib" Click="ConnectClicked" Padding="13,8" Margin="0,0,8,8"/>
</WrapPanel>
<WrapPanel><TextBox Name="Credential" Width="320" Padding="8" ToolTip="Phone number, code or 2FA password"/><Button Content="Submit login step" Click="SubmitClicked" Padding="13,8" Margin="8,0"/></WrapPanel>
</StackPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<ListBox Name="Chats" SelectionChanged="ChatSelected" DisplayMemberPath="Label"/>
<StackPanel Grid.Column="1" Margin="15,0,0,0"><TextBlock Name="ChatTitle" Text="Bot chats" FontWeight="Bold" FontSize="20"/><ListBox Name="Messages" Height="360"/><DockPanel Margin="0,12,0,0"><TextBox Name="Composer" Width="340" Padding="9"/><Button Content="Send" Padding="12,8" Click="SendClicked"/></DockPanel></StackPanel>
</Grid>
<TextBlock Grid.Row="3" Foreground="#687B84" TextWrapping="Wrap" Text="Native TDLib requires tdjson.dll. Login requires Telegram developer credentials. This version has not been certified or end-to-end tested."/>
</Grid></Window>