{
  "name": "bothub-desktop",
  "version": "0.3.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "build:windows": "electron-builder --win nsis",
    "build:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.botify.bothub.desktop",
    "productName": "BotHub",
    "files": [
      "main.cjs",
      "index.html"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  }
}