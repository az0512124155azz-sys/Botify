{
  "expo": {
    "name": "BotHub",
    "slug": "bothub",
    "scheme": "bothub",
    "version": "0.4.0",
    "orientation": "portrait",
    "android": {
      "package": "com.botify.bothub",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/bothub-icon.png",
        "backgroundColor": "#F5F8FA"
      }
    },
    "ios": {
      "bundleIdentifier": "com.botify.bothub",
      "supportsTablet": true
    },
    "plugins": [
      "expo-secure-store"
    ],
    "icon": "./assets/bothub-icon.png"
  }
}
